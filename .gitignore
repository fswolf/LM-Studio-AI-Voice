__pycache__/
*.pyc

# Conversation log, the full transcript archive, scheduled reminders
# and the long-term fact database - all personal, all regenerated at
# runtime.
history/conversation.json
history/transcript.jsonl
reminders/reminders.json
agent/facts.db
agent/mood.json
agent/facts.db-wal
agent/facts.db-shm

# Screenshots and previews dropped here while working
Claude outputs/

# Virtualenvs, in case one ever lands inside the repo
ai-voice-venv/
.venv/
venv/
tts/*/venv/
tts/*/qwentts.cpp/
tts/*/models/
*.gguf

# Reference voice clips are recordings, not source.
tts/*/voices/*
!tts/*/voices/README.md

# Plugins are tracked - all of them, including any you add later.
# This used to be an allow-list, which meant a new plugin was invisible
# to `git add -A` until you remembered to name it here, and the only
# symptom was a push that quietly left it behind.
#
# The trade is that plugins/ now goes to GitHub as-is, so keep anything
# private out of the file itself. Credentials already live in
# ~/.config/ai-voice/ rather than beside the code, and channel or
# account names belong in config.json, not hard-coded in the plugin.

# Credentials. The real ones live in ~/.config/ai-voice/, outside the
# repo entirely - these are here in case a copy ever lands beside the
# code by accident.
pomf.json
irc.json
*.key

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
