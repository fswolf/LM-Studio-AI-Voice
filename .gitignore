__pycache__/
*.pyc

# Conversation log, the full transcript archive, scheduled reminders
# and the long-term fact database - all personal, all regenerated at
# runtime.
history/conversation.json
history/transcript.jsonl
reminders/reminders.json
agent/facts.db
agent/mood.json
agent/facts.db-wal
agent/facts.db-shm

# Screenshots and previews dropped here while working
Claude outputs/

# Virtualenvs, in case one ever lands inside the repo
ai-voice-venv/
.venv/
venv/
tts/*/venv/
tts/*/qwentts.cpp/
tts/*/models/
*.gguf

# Reference voice clips are recordings, not source.
tts/*/voices/*
!tts/*/voices/README.md

# Plugins are private by default: anything you drop in plugins/ is
# yours - channel names, account names, whatever you wire her up to -
# so nothing there is tracked unless it is listed below. Add a line to
# publish one; the credentials it reads stay out either way, because
# those live in ~/.config rather than beside the code.
plugins/*
!plugins/__init__.py
!plugins/example.py
!plugins/pomf.py

# Credentials. The real ones live in ~/.config/ai-voice/, outside the
# repo entirely - these are here in case a copy ever lands beside the
# code by accident.
pomf.json
irc.json
*.key

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
